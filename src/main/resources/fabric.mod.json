{
    "schemaVersion": 1,
    "id": "grid",
    "version": "${version}",
    "environment": "client",
    "entrypoints": {
        "client": [ "de.guntram.mcmod.grid.Grid" ],
        "modmenu": [ "de.guntram.mcmod.grid.modConfig.ModMenuHandler" ]
    },
    "mixins": [
      	"mixins.grid.json"
    ],
    "depends": {
        "fabric-api": "*",
        "fabricloader": "*",
        "minecraft": "${minecraft_range}",
        "java": ">=25",
        "modmenu": "*",
        "cloth-config": "*"
    },
    "name": "Grid Updated",
    "description": "Markers to help with counting blocks, building circles, and showing possible mob spawn locations",
    "icon": "icon.png",
    "authors": [ "Giselbaer", "CCPCT" ],
    "contact": {
        "homepage": "https://modrinth.com/mod/grid-updated",
        "sources": "https://github.com/CCPCT/Grid-Updated",
        "issues": "https://github.com/CCPCT/Grid-Updated/issues"
    }
}
